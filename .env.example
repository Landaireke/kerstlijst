# --- Optioneel (betaald): zonder deze twee draait de agent in gratis modus ---
# Firecrawl: zoekt en leest webshops, Tweakers en Vinted (https://firecrawl.dev → API keys)
FIRECRAWL_API_KEY=fc-xxxxxxxx
# Anthropic: beoordeelt foto's van tweedehandstruien (model, vlekken, scheuren, namaak) en onbekende shops
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Planning ---
# Elke ochtend om 07:00 Brusselse tijd
CRON_SCHEDULE=0 7 * * *
TZ=Europe/Brussels
# Zet op false als je de agent via een externe cron (bv. Render Cron Job) laat draaien
ENABLE_INTERNAL_CRON=true

# --- Server ---
PORT=3000
# Wachtwoord voor de knop "Nu checken" en het aanpassen van items
ADMIN_TOKEN=kies-een-lang-wachtwoord

# --- Regels ---
# Minimale betrouwbaarheidsscore (0-100) om als "beste deal" te mogen tellen
MIN_TRUST_SCORE=65
# Maximaal aantal tweedehandsadvertenties per item dat met foto's wordt gecontroleerd (kost API-credits)
MAX_VISION_CHECKS_PER_ITEM=8

# --- Opslag (gratis) ---
SUPABASE_URL=
SUPABASE_KEY=
KL_STORE_SECRET=
